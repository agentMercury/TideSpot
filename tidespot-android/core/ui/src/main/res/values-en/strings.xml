    <!-- OPT-V11-13: disclaimers (SRS §9.6 / D11: exactly 5) -->
    <string name="ts_disclaimer_title">Disclaimer</string>
    <string name="ts_disclaimer_entry">Disclaimer</string>
    <string name="ts_disclaimer_wave_tide">Tide levels and currents come from a ~8 km global model and are officially not suitable for coastal navigation. This app does not replace nautical guides or official tide tables.</string>
    <string name="ts_disclaimer_weather">Thunderstorm, gale and high-wave judgments are for reference only. Water safety follows local warnings; never fish during lightning, typhoons or spring tides.</string>
    <string name="ts_disclaimer_score">The score is an empirical weighting of weather and astronomical factors and does not guarantee catch.</string>
    <string name="ts_disclaimer_water_quality">Most water-quality values in China are model estimates, not measurements; do not use them as a basis for drinking, potable water or safe contact.</string>
    <string name="ts_disclaimer_tide_correction">\"On-site tide calibration\" is your own recorded high-tide observations used as an empirical correction of model lag (time shift); it is for relative timing reference only. Calibration does not change the data source or accuracy and is still not an official tide table.</string>

